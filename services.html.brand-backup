<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MediaBay — Services</title>
<meta name="description" content="MediaBay digital infrastructure services: strategy, web, commerce, content, SEO, AI and phygital.">
<style>
:root{--cream:#f1e7d2;--paper:#f8f3e8;--green:#173d2a;--acid:#c8ff32;--ink:#102b1d;--line:rgba(16,43,29,.18);--muted:#657267}
*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}
header{height:72px;padding:0 4vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(241,231,210,.94);backdrop-filter:blur(14px);z-index:2}
.logo{font-size:23px;font-weight:900;letter-spacing:-.07em}nav{display:flex;gap:20px;font-size:10px;letter-spacing:.14em;text-transform:uppercase}
.hero{background:var(--green);color:var(--cream);padding:10vw 4vw 8vw}.eyebrow{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--acid);font-weight:700}
h1{font-size:clamp(65px,12vw,175px);line-height:.77;letter-spacing:-.09em;margin:28px 0}.hero p{font-size:19px;line-height:1.4;max-width:650px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.card{min-height:300px;padding:30px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column;justify-content:space-between;transition:.2s}.card:hover{background:var(--acid)}.num{font-size:10px;letter-spacing:.15em;color:#2f6a46}h2{font-size:clamp(38px,5vw,75px);line-height:.84;letter-spacing:-.075em;margin:30px 0 15px}.card p{font-size:13px;color:var(--muted);max-width:420px}.card span{font-size:10px;letter-spacing:.15em}
footer{background:var(--green);color:var(--cream);padding:30px 4vw;font-size:9px;letter-spacing:.14em;text-transform:uppercase}
@media(max-width:650px){nav{display:none}.grid{grid-template-columns:1fr}.card{min-height:230px}}
</style><style id="mediabay-v51-home-shared">
:root{--mb-acid:#c8ff32;--mb-ink:#101510}
.mb-site-header{position:fixed;z-index:9000;left:0;top:0;width:100%;height:76px;padding:0 30px;display:flex;align-items:center;justify-content:space-between;color:#fff;border-bottom:1px solid #ffffff30;mix-blend-mode:difference}
.mb-site-header .mb-logo{font-size:19px;font-weight:800;letter-spacing:-.07em;text-decoration:none;color:inherit;display:flex;align-items:center;gap:8px}
.mb-site-header .mb-brand-symbol{display:inline-flex;align-items:center}.mb-site-header .mb-brand-logo{height:22px;width:auto;display:block}.mb-logo-green{display:none!important}.mb-logo-white{display:block!important}
.mb-lang-switch{display:flex;gap:5px;align-items:center;margin-left:auto;margin-right:22px}.mb-lang-switch button{border:0;background:transparent;color:inherit;font:inherit;font-size:9px;letter-spacing:.12em;padding:5px;opacity:.48;cursor:pointer}.mb-lang-switch button.active{opacity:1;font-weight:700}
.mb-menu-btn{border:0;background:none;color:inherit;display:flex;align-items:center;cursor:pointer;padding:8px 0}.mb-menu-icon{width:30px;height:16px;position:relative;display:block}.mb-menu-icon i{position:absolute;left:0;width:100%;height:1px;background:currentColor;transition:.35s}.mb-menu-icon i:first-child{top:4px}.mb-menu-icon i:last-child{top:12px}.mb-menu-open .mb-menu-icon i:first-child{top:8px;transform:rotate(45deg)}.mb-menu-open .mb-menu-icon i:last-child{top:8px;transform:rotate(-45deg)}
.mb-site-menu{position:fixed;z-index:8999;inset:0;background:var(--mb-acid);color:var(--mb-ink);padding:105px 5vw 28px;display:flex;flex-direction:column;transform:translateY(-101%);transition:transform .8s cubic-bezier(.77,0,.18,1)}
.mb-site-menu.open{transform:translateY(0)}.mb-site-menu .mb-menu-info,.mb-site-menu .mb-menu-foot{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.17em;text-transform:uppercase}.mb-site-menu nav{margin:auto 0}.mb-site-menu nav a{display:grid;grid-template-columns:55px 1fr;text-decoration:none;color:inherit;font-size:clamp(52px,9.5vw,145px);line-height:.84;letter-spacing:-.08em;font-weight:800;border-bottom:1px solid rgba(16,21,16,.25);padding:5px 0;transition:padding-left .3s}.mb-site-menu nav a:hover{padding-left:25px}.mb-site-menu nav span{font-size:10px;letter-spacing:.1em;font-weight:400}
body.mb-menu-active{overflow:hidden}
@media(max-width:700px){.mb-site-header{height:62px;padding:0 18px}.mb-site-header .mb-logo{font-size:17px}.mb-site-header .mb-brand-logo{height:18px}.mb-lang-switch{margin-right:10px;gap:2px}.mb-lang-switch button{font-size:8px}.mb-menu-icon{width:28px}.mb-site-menu{padding:82px 18px 20px}.mb-site-menu .mb-menu-info,.mb-site-menu .mb-menu-foot{font-size:7px}.mb-site-menu nav a{grid-template-columns:32px 1fr;font-size:15.2vw;padding:7px 0}.mb-site-menu nav span{font-size:8px}.mb-site-menu nav a:hover{padding-left:0}}
</style>\n</head>
<body>\n<header class="mb-site-header" id="mbHeader">
<a class="mb-logo" href="index.html#top" aria-label="MediaBay home"><span class="mb-brand-symbol"><img alt="" class="mb-brand-logo mb-logo-white" src="mediabay-logo-white.png"><img alt="" class="mb-brand-logo mb-logo-green" src="mediabay-logo-green.png"></span><span>MediaBay</span></a>
<div class="mb-lang-switch" aria-label="Language"><button type="button" data-lang="it">IT</button><button type="button" data-lang="en">EN</button></div>
<button aria-controls="mbSiteMenu" aria-expanded="false" class="mb-menu-btn" id="mbMenuBtn" type="button"><b aria-hidden="true" class="mb-menu-icon"><i></i><i></i></b></button>
</header>
<div class="mb-site-menu" id="mbSiteMenu">
<div class="mb-menu-info"><span>MEDIA BAY</span><span>PHYGITAL MARKETING · SINCE 2013</span></div>
<nav>
<a href="index.html#team"><span>02</span>ABOUT</a><a href="index.html#demo"><span>03</span>STARTING POINT</a><a href="index.html#manifesto"><span>04</span>SYSTEM</a><a href="index.html#services"><span>05</span>MEDIA BAY SYSTEM</a><a href="index.html#projects"><span>06</span>HOW IT WORKS</a><a href="index.html#clients"><span>07</span>BUSINESSES</a><a href="index.html#contact"><span>08</span>START</a>
</nav>
<div class="mb-menu-foot"><span>WEB · SOCIAL · AI · MOBILITY</span><span>ENTER THE BAY ↘</span></div>
</div><header><a class="logo" href="index.html">MEDIA<span>BAY</span></a><nav><a href="index.html">Home</a><a href="brief.html">Start</a></nav></header>
<section class="hero"><div class="eyebrow">MEDIA BAY · SERVICE SYSTEM</div><h1>BUILD THE<br><em style="color:var(--acid);font-style:normal">DIGITAL.</em></h1><p>All MediaBay service layers in one place. Each page has its own experience, while the system stays connected.</p></section>
<main class="grid"><a class="card" href="strategy-brand.html"><div class="num">01</div><div><h2>Strategy &amp; Brand</h2><p>Direction before decoration.</p></div><span>OPEN ↗</span></a><a class="card" href="websites-landing.html"><div class="num">02</div><div><h2>Websites &amp; Landing Pages</h2><p>Your business deserves a digital home.</p></div><span>OPEN ↗</span></a><a class="card" href="ecommerce.html"><div class="num">03</div><div><h2>E-commerce</h2><p>Commerce infrastructure for the business.</p></div><span>OPEN ↗</span></a><a class="card" href="social-content.html"><div class="num">04</div><div><h2>Social &amp; Content</h2><p>One idea. Many expressions.</p></div><span>OPEN ↗</span></a><a class="card" href="seo-google-ads.html"><div class="num">05</div><div><h2>SEO, Google &amp; Advertising</h2><p>Be found. Then chosen.</p></div><span>OPEN ↗</span></a><a class="card" href="ai-automation.html"><div class="num">06</div><div><h2>AI &amp; Automation</h2><p>Make the business flow.</p></div><span>OPEN ↗</span></a><a class="card" href="mobility-phygital.html"><div class="num">07</div><div><h2>Mobility &amp; Phygital</h2><p>Physical presence. Digital impact.</p></div><span>OPEN ↗</span></a></main>
<footer>MEDIABAY · DIGITAL INFRASTRUCTURE · WEB · COMMERCE · CONTENT · AI · PHYGITAL</footer>
<script id="mediabay-v51-home-navigation">(function(){const m=document.getElementById("mbSiteMenu"),b=document.getElementById("mbMenuBtn");if(!m||!b)return;const close=()=>{m.classList.remove("open");b.classList.remove("mb-menu-open");b.setAttribute("aria-expanded","false");document.body.classList.remove("mb-menu-active")};b.onclick=()=>{m.classList.contains("open")?close():(m.classList.add("open"),b.classList.add("mb-menu-open"),b.setAttribute("aria-expanded","true"),document.body.classList.add("mb-menu-active"))};m.querySelectorAll("a").forEach(a=>a.onclick=close);document.addEventListener("keydown",e=>e.key==="Escape"&&close());const bs=[...document.querySelectorAll(".mb-lang-switch button")];let l=localStorage.getItem("mediabay-language")||"it";const set=v=>{l=v;localStorage.setItem("mediabay-language",v);document.documentElement.lang=v;bs.forEach(x=>x.classList.toggle("active",x.dataset.lang===v))};bs.forEach(x=>x.onclick=()=>set(x.dataset.lang));set(l)})();</script>\n</body></html>