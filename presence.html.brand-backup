<script>
const panel=document.getElementById('menuPanel'),btn=document.getElementById('menuBtn');
btn.addEventListener('click',()=>{panel.classList.toggle('open');btn.textContent=panel.classList.contains('open')?'CLOSE':'MENU'});
panel.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{panel.classList.remove('open');btn.textContent='MENU'}));
function setLang(lang){localStorage.setItem('mediabay-language',lang);document.documentElement.lang=lang;
document.querySelectorAll('[data-lang]').forEach(b=>b.classList.toggle('active',b.dataset.lang===lang));
document.querySelectorAll('[data-it]').forEach(el=>{const v=el.getAttribute('data-'+lang);if(v!==null)el.innerHTML=v})}
setLang(localStorage.getItem('mediabay-language')||'it');
document.querySelectorAll('[data-lang]').forEach(b=>b.addEventListener('click',()=>setLang(b.dataset.lang)));
</script>
<div id="mb-cookie" role="dialog" aria-label="Informativa cookie">
  <div class="mb-cookie-copy">
    <strong>Cookie & privacy</strong>
    <p>Usiamo cookie e strumenti tecnici necessari al funzionamento del sito e, se lo scegli, per ricordare le tue preferenze. Nessun cookie pubblicitario di terze parti è attivo in questa versione.</p>
  </div>
  <div class="mb-cookie-actions">
    <button class="mb-cookie-btn" type="button" id="mb-cookie-close">Continua</button>
    <button class="mb-cookie-btn primary" type="button" id="mb-cookie-ok">OK</button>
  </div>
</div>


<script id="mediabay-ui-system">
(function(){
  const body=document.body;
  const loader=document.getElementById('mb-loader');
  body.classList.add('mb-loading');
  const hideLoader=()=>{setTimeout(()=>{body.classList.remove('mb-loading');loader?.classList.add('is-hidden')},500)};
  if(document.readyState==='complete') hideLoader(); else window.addEventListener('load',hideLoader,{once:true});

  document.querySelectorAll('a[href]').forEach(a=>{
    a.addEventListener('click',function(e){
      const href=this.getAttribute('href');
      if(!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || this.target==='_blank') return;
      let url; try{url=new URL(href,location.href)}catch(_){return}
      if(url.origin!==location.origin) return;
      if(url.pathname===location.pathname && url.hash) return;
      if(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey) return;
      e.preventDefault();
      body.classList.add('mb-leaving');
      setTimeout(()=>{location.href=url.href},260);
    });
  });

  const cookie=document.getElementById('mb-cookie');
  const close=()=>{localStorage.setItem('mediabay-cookie-notice-v116','seen');cookie?.classList.add('is-hidden')};
  if(localStorage.getItem('mediabay-cookie-notice-v116')==='seen') cookie?.classList.add('is-hidden');
  document.getElementById('mb-cookie-close')?.addEventListener('click',close);
  document.getElementById('mb-cookie-ok')?.addEventListener('click',close);
})();
</script>




