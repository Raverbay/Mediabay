<style id="mediabay-ui-css">
/* MEDIABAY — PRELOADER + PAGE TRANSITIONS */
#mb-loader{position:fixed;inset:0;z-index:9999;background:#070a0b;color:#f0eee7;display:grid;place-items:center;transition:opacity .45s ease,visibility .45s ease}
#mb-loader.is-hidden{opacity:0;visibility:hidden;pointer-events:none}
.mb-loader-inner{text-align:center;padding:30px}
.mb-loader-logo{font:800 clamp(42px,9vw,82px)/.85 Arial,Helvetica,sans-serif;letter-spacing:-.075em}
.mb-loader-sub{margin-top:10px;font:600 9px/1 Arial,Helvetica,sans-serif;letter-spacing:.22em;color:#c8ff00;text-transform:uppercase}
.mb-loader-line{width:120px;height:2px;background:#ffffff18;margin:28px auto 0;overflow:hidden}
.mb-loader-line:after{content:"";display:block;width:45%;height:100%;background:#c8ff00;animation:mbLoad 1s ease-in-out infinite}
@keyframes mbLoad{0%{transform:translateX(-120%)}100%{transform:translateX(340%)}}
body.mb-loading{overflow:hidden}
body.mb-leaving #mb-loader{opacity:1;visibility:visible}
body.mb-leaving #mb-loader .mb-loader-line:after{animation:none;transform:translateX(120%)}
@media(prefers-reduced-motion:reduce){#mb-loader{transition:none}.mb-loader-line:after{animation:none}}

/* MEDIABAY — COOKIE NOTICE */
#mb-cookie{position:fixed;z-index:9998;left:18px;right:18px;bottom:18px;max-width:760px;background:#f0eee7;color:#070a0b;border:1px solid #070a0b22;box-shadow:0 18px 60px #0005;padding:18px 20px;display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;transform:translateY(0);transition:transform .35s ease,opacity .35s ease}
#mb-cookie.is-hidden{transform:translateY(130%);opacity:0;pointer-events:none}
.mb-cookie-copy strong{display:block;font:800 10px/1.2 Arial,Helvetica,sans-serif;letter-spacing:.13em;text-transform:uppercase;margin-bottom:7px}
.mb-cookie-copy p{margin:0;max-width:560px;font:400 11px/1.45 Arial,Helvetica,sans-serif;color:#303633}
.mb-cookie-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.mb-cookie-btn{border:1px solid #070a0b;background:transparent;color:#070a0b;padding:12px 15px;font:800 8px/1 Arial,Helvetica,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.mb-cookie-btn.primary{background:#c8ff00;border-color:#c8ff00}
@media(max-width:700px){#mb-cookie{left:12px;right:12px;bottom:12px;grid-template-columns:1fr;gap:14px;padding:16px}.mb-cookie-actions{justify-content:flex-start}.mb-cookie-btn{flex:1}}
</style>

