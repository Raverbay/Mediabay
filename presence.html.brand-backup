<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>MediaBay — Presence · The Digital Storefront</title>
  <meta property="og:description" content="Presence is MediaBay's digital storefront system for businesses that need to be found, understood and contacted.">
  <meta property="og:title" content="MediaBay — Presence · The Digital Storefront">
  <link rel="canonical" href="https://mediabay.it/presence.html">
  <meta name="description" content="Presence is MediaBay's digital storefront system for businesses that need to be found, understood and contacted."><style>
:root{--ink:#070a0b;--panel:#0d1214;--paper:#eceae3;--lime:#c8ff00;--cyan:#64e8ff;--blue:#5da5ff;--red:#ff3b30;--muted:#aab3b4;--line:#ffffff22;--serif:Georgia,"Times New Roman",serif;--sans:Arial,Helvetica,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ink);color:var(--paper);font-family:var(--sans);overflow-x:hidden}a{color:inherit}button{font:inherit}
.site-header{position:fixed;z-index:100;top:0;left:0;width:100%;height:70px;padding:0 4vw;display:flex;align-items:center;justify-content:space-between;background:#070a0bd9;border-bottom:1px solid #ffffff14;backdrop-filter:blur(14px);color:#fff}
.logo{font-size:20px;font-weight:900;letter-spacing:-.06em;text-decoration:none}.logo small{display:block;font-size:7px;font-weight:400;letter-spacing:.14em;color:var(--lime);margin-top:2px}
.nav{display:flex;gap:22px;font-size:8px;letter-spacing:.15em;text-transform:uppercase}.nav a{text-decoration:none;opacity:.65}.nav a:hover{opacity:1;color:var(--lime)}
.lang{display:flex;gap:7px;font-size:8px;letter-spacing:.15em}.lang button{border:0;background:none;color:#fff;opacity:.4;cursor:pointer;padding:3px}.lang button.active{opacity:1;color:var(--lime)}
.menu{display:none;background:none;border:1px solid #ffffff30;color:#fff;padding:8px 11px;font-size:8px;letter-spacing:.13em;text-transform:uppercase}
.page-hero{min-height:86svh;padding:125px 4vw 60px;display:grid;grid-template-columns:1fr .75fr;align-items:end;gap:6vw;position:relative;overflow:hidden;background:#070a0b}
.page-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#070a0b 0%,#070a0bdc 42%,#070a0b55 100%);z-index:0}
.page-art{position:absolute;right:0;top:0;width:62%;height:100%;object-fit:cover;opacity:.52}
.hero-content,.hero-side{position:relative;z-index:1}.eyebrow{font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--lime)}
.page-hero h1{font-size:clamp(4rem,9vw,10rem);line-height:.77;letter-spacing:-.09em;margin:25px 0;font-weight:900;max-width:850px}.page-hero h1 em{font-style:normal;color:var(--lime)}
.hero-copy{max-width:540px;font-size:16px;line-height:1.5;color:#c1c9ca}.hero-side{justify-self:end;max-width:300px}.hero-side .big{font-family:var(--serif);font-size:clamp(3rem,6vw,6rem);line-height:.85;margin:0 0 20px}.hero-side p{font-size:10px;line-height:1.55;color:#8e9899}
.btn{display:inline-flex;padding:14px 20px;background:var(--lime);color:var(--ink);text-decoration:none;font-size:8px;letter-spacing:.15em;text-transform:uppercase;font-weight:900;margin-top:20px}.btn.alt{background:transparent;color:#fff;border:1px solid #ffffff55}
.section{padding:9vw 4vw}.paper{background:var(--paper);color:var(--ink)}.dark{background:#080b0c}
.section-head{display:grid;grid-template-columns:1fr .7fr;gap:6vw;align-items:end}.section h2{font-family:var(--serif);font-weight:400;font-size:clamp(3rem,6.5vw,7rem);line-height:.85;letter-spacing:-.06em;margin:18px 0}.section-head p{font-size:14px;line-height:1.55;color:#7e8787;max-width:460px}
.feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#18231833;margin-top:6vw}.feature{padding:30px;min-height:220px;background:#f5f2e9}.feature:nth-child(2){background:#dce8df}.feature:nth-child(3){background:#dfe8ed}.feature:nth-child(4){background:#eadbd1}.feature b{font-size:8px;letter-spacing:.16em}.feature h3{font-size:clamp(2.1rem,4vw,4.3rem);line-height:.84;letter-spacing:-.06em;margin:70px 0 10px}.feature p{font-size:10px;line-height:1.5;opacity:.68;max-width:380px}
.metric{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:5vw}.metric-card{background:#101719;border:1px solid #ffffff18;padding:28px}.metric-card strong{display:block;font-size:clamp(3rem,5vw,6rem);line-height:.8;color:var(--lime);letter-spacing:-.08em}.metric-card span{display:block;margin-top:20px;font-size:8px;letter-spacing:.15em;text-transform:uppercase;color:#9ca5a6}
.process{border-top:1px solid #ffffff30;margin-top:6vw}.process-row{display:grid;grid-template-columns:70px 1fr 1fr;gap:20px;padding:26px 0;border-bottom:1px solid #ffffff30}.process-row b{font-size:8px;color:var(--cyan);letter-spacing:.15em}.process-row h3{margin:0;font-size:clamp(2rem,4vw,4rem);letter-spacing:-.06em;line-height:.85}.process-row p{margin:0;color:#8f999a;font-size:10px;line-height:1.5}
.price-band{background:var(--lime);color:var(--ink);padding:45px 4vw;display:flex;justify-content:space-between;align-items:center;gap:30px}.price-band .price{font-size:clamp(3.5rem,7vw,7rem);font-weight:900;letter-spacing:-.08em}.price-band small{font-size:10px;letter-spacing:.12em}.price-band p{max-width:430px;font-size:12px;line-height:1.5}
.faq{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:5vw}.faq details{border-top:1px solid #ffffff30;padding:18px 0}.faq summary{cursor:pointer;font-size:11px;letter-spacing:.06em}.faq p{color:#8f999a;font-size:10px;line-height:1.55;max-width:500px}
.cta{background:#080b0c;color:#fff;padding:9vw 4vw;min-height:48vh;display:flex;flex-direction:column;justify-content:space-between;background-image:linear-gradient(90deg,#080b0cf4,#080b0c66),url("assets/tech-art-cta.jpg");background-size:cover;background-position:center}.cta h2{font-family:var(--serif);font-weight:400;font-size:clamp(3.2rem,6.5vw,7rem);line-height:.84;letter-spacing:-.06em;margin:18px 0}.footer{border-top:1px solid #ffffff30;padding-top:15px;display:flex;justify-content:space-between;gap:20px;font-size:8px;letter-spacing:.14em;text-transform:uppercase}
#menuPanel{position:fixed;inset:0;z-index:90;background:var(--lime);color:var(--ink);padding:105px 5vw 25px;transform:translateY(-101%);transition:transform .7s cubic-bezier(.77,0,.18,1);display:flex;flex-direction:column}#menuPanel.open{transform:none}#menuPanel nav{margin:auto 0;display:grid}#menuPanel nav a{font-size:clamp(3rem,8vw,8.5rem);line-height:.82;text-decoration:none;font-weight:900;letter-spacing:-.08em;border-bottom:1px solid #18231844;padding:6px 0}


body.identity-presence{background:#e9e7df;color:#182318}
.identity-presence .site-header{background:#e9e7dfdf;color:#182318;border-color:#18231818}
.identity-presence .site-header .logo small,.identity-presence .eyebrow{color:#69a84f}
.identity-presence .site-header .lang button{color:#182318}.identity-presence .menu{color:#182318;border-color:#18231844}
.identity-presence .page-hero{background:#e9e7df;color:#182318;min-height:82svh}
.identity-presence .page-hero:after{background:linear-gradient(90deg,#e9e7df 0%,#e9e7dfc9 44%,#e9e7df30 100%)}
.identity-presence .page-art{opacity:.55;filter:saturate(.72) sepia(.08)}
.identity-presence .hero-copy,.identity-presence .hero-side p{color:#4d554d}
.identity-presence .page-hero h1 em{color:#69a84f}
.identity-presence .price-band{background:#b7ff00}
.identity-presence .feature-grid{background:#18231822}.identity-presence .feature{background:#f4f1e8}.identity-presence .feature:nth-child(2){background:#e0ead8}
.identity-presence .cta{background:#182318}


/* V100 PRESENCE — "THE FIRST IMPRESSION" */
body.identity-presence{
  --presence-green:#69a84f;
  --presence-dark:#182318;
  --presence-paper:#eee9dc;
  --presence-mist:#dce5d5;
  background:var(--presence-paper);color:var(--presence-dark);
}
.identity-presence .site-header{
  background:#eee9dce8;color:var(--presence-dark);
  border-bottom:1px solid #18231818;
}
.identity-presence .site-header .logo small,
.identity-presence .eyebrow{color:var(--presence-green)}
.identity-presence .site-header .lang button{color:var(--presence-dark)}
.identity-presence .menu{color:var(--presence-dark);border-color:#18231844}

/* Hero: editorial / calm / local / human */
.identity-presence .page-hero{
  min-height:94svh;background:var(--presence-paper);color:var(--presence-dark);
  grid-template-columns:1.05fr .65fr;padding-top:110px;
}
.identity-presence .page-hero:before{
  content:"01";position:absolute;right:5vw;top:105px;
  font-size:10px;letter-spacing:.2em;color:#18231866;z-index:2;
}
.identity-presence .page-hero:after{
  background:
    linear-gradient(90deg,#eee9dc 0%,#eee9dc 37%,#eee9dc55 68%,#eee9dc05 100%);
}
.identity-presence .page-art{
  width:58%;height:88%;top:8%;opacity:.82;
  filter:saturate(.72) contrast(.96) sepia(.08);
  clip-path:polygon(9% 0,100% 0,100% 88%,0 100%,0 15%);
}
.identity-presence .page-hero h1{
  font-family:var(--serif);font-weight:400;
  font-size:clamp(5rem,10vw,11rem);
  line-height:.72;letter-spacing:-.085em;margin:20px 0 30px;
}
.identity-presence .page-hero h1 em{
  color:var(--presence-green);font-style:italic;
}
.identity-presence .hero-copy{
  max-width:470px;color:#4c554b;font-size:17px;
}
.identity-presence .hero-side{
  align-self:center;justify-self:end;
  max-width:280px;padding:22px 0 0 28px;border-left:1px solid #18231855;
}
.identity-presence .hero-side .big{
  font-family:var(--sans);font-weight:800;font-size:clamp(3.8rem,6vw,6.5rem);
  letter-spacing:-.09em;color:var(--presence-green);
}
.identity-presence .hero-side p{color:#687066}

/* Package navigation becomes a progression, not generic links */
.identity-presence .page-hero .hero-content:after{
  content:"PRESENCE  /  THE FOUNDATION";
  display:block;margin-top:42px;font-size:7px;letter-spacing:.2em;
  color:#18231866;
}

/* Price band = reassurance */
.identity-presence .price-band{
  background:#b7ff00;color:var(--presence-dark);
  padding:32px 4vw;position:relative;
}
.identity-presence .price-band:after{
  content:"START SMALL. BUILD WELL.";
  position:absolute;right:4vw;top:50%;transform:translateY(-50%);
  font-size:8px;letter-spacing:.18em;font-weight:800;
}
.identity-presence .price-band .price{font-size:clamp(3.8rem,7vw,7rem)}

/* Distinct value story */
.identity-presence .section.paper{
  background:var(--presence-paper);
}
.identity-presence #details .section-head{
  grid-template-columns:1.2fr .55fr;
}
.identity-presence #details h2{
  font-size:clamp(4rem,7vw,8rem);
}
.identity-presence .feature-grid{
  grid-template-columns:repeat(4,1fr);
  background:#18231822;
}
.identity-presence .feature{
  min-height:330px;padding:24px;background:#f6f1e5;
}
.identity-presence .feature:nth-child(2){background:#e2eadb}
.identity-presence .feature:nth-child(3){background:#e8eee3}
.identity-presence .feature:nth-child(4){background:#d9e4d1}
.identity-presence .feature h3{
  font-family:var(--serif);font-weight:400;
  font-size:clamp(2.4rem,3.7vw,4.3rem);
  margin:92px 0 12px;
}
.identity-presence .feature p{color:#596257}

/* A signature "digital storefront" section */
.identity-presence .presence-window{
  margin-top:6vw;display:grid;grid-template-columns:.75fr 1.25fr;
  min-height:500px;background:var(--presence-dark);color:#f3f0e7;
}
.identity-presence .presence-window .window-copy{
  padding:44px;display:flex;flex-direction:column;justify-content:space-between;
}
.identity-presence .presence-window h3{
  font-family:var(--serif);font-weight:400;
  font-size:clamp(3rem,5vw,6rem);line-height:.83;
  letter-spacing:-.06em;margin:20px 0;
}
.identity-presence .presence-window p{max-width:340px;color:#aab4a9;font-size:12px;line-height:1.55}
.identity-presence .presence-window .window-art{
  background:
    linear-gradient(90deg,#182318 0%,#18231811 25%),
    url("assets/tech-art-hero.jpg") center/cover;
  min-height:420px;filter:saturate(.55) sepia(.08);
  position:relative;
}
.identity-presence .presence-window .window-art:after{
  content:"YOUR BUSINESS / ONLINE";
  position:absolute;left:28px;bottom:28px;
  color:#fff;font-size:8px;letter-spacing:.18em;
}

/* Process is intentionally slower and more human */
.identity-presence .section.dark{
  background:var(--presence-dark);
}
.identity-presence .process-row{
  padding:34px 0;
}
.identity-presence .process-row h3{
  font-family:var(--serif);font-weight:400;
}
.identity-presence .process-row b{color:var(--presence-green)}

/* FAQ becomes reassurance */
.identity-presence .faq details{
  border-color:#18231833;padding:24px 0;
}
.identity-presence .faq summary{font-size:12px}
.identity-presence .cta{
  background:var(--presence-dark);
  background-image:
    linear-gradient(90deg,#182318f5,#182318a6),
    url("assets/tech-art-cta.jpg");
}
.identity-presence .cta h2{font-family:var(--serif);font-weight:400}
.identity-presence .cta .eyebrow{color:var(--presence-green)}





/* V115.6 FOOTER — CONTACT + SUBMENU */
.footer{margin-top:70px;border-top:1px solid #ffffff30;padding:42px 0 18px;display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:42px;font-size:10px;letter-spacing:.08em;text-transform:uppercase}
.footer-col{display:flex;flex-direction:column;gap:11px}
.footer-label{font-size:8px;letter-spacing:.18em;opacity:.55;margin-bottom:4px}
.footer-brand{font-size:22px;letter-spacing:-.03em;font-weight:800;line-height:1}
.footer-muted{opacity:.65;line-height:1.7;text-transform:none;letter-spacing:.02em}
.footer a{color:inherit;text-decoration:none}
.footer a:hover{text-decoration:underline;text-underline-offset:4px}
.footer-nav{display:grid;grid-template-columns:1fr 1fr;gap:9px 18px}
.footer-nav a{font-size:9px;letter-spacing:.12em}
.footer-bottom{grid-column:1/-1;border-top:1px solid #ffffff20;padding-top:14px;margin-top:8px;display:flex;justify-content:space-between;gap:20px;opacity:.65;font-size:8px}



/* =========================================================
   MEDIABAY MOBILE EXPERIENCE V1 — PRESENCE
   One coherent mobile composition.
   ========================================================= */

@media (max-width:800px){

  html,
  body{
    overflow-x:hidden;
  }

  /* ---------- HEADER ---------- */

  .site-header{
    height:62px !important;
    padding:0 18px !important;
  }

  .nav{
    display:none !important;
  }

  .menu{
    display:block !important;
  }

  /* ---------- HERO ---------- */

  .identity-presence .page-hero{
    min-height:100svh !important;
    height:auto !important;
    display:flex !important;
    flex-direction:column !important;
    justify-content:flex-end !important;
    padding:88px 20px 42px !important;
    position:relative !important;
    overflow:hidden !important;
  }

  .identity-presence .page-art{
    position:absolute !important;
    inset:62px 0 0 !important;
    width:100% !important;
    height:calc(100% - 62px) !important;
    object-fit:cover !important;
    object-position:center !important;
    opacity:.46 !important;
    clip-path:none !important;
    z-index:0 !important;
  }

  .identity-presence .page-hero:after{
    content:"" !important;
    position:absolute !important;
    inset:0 !important;
    background:
      linear-gradient(
        180deg,
        rgba(238,233,220,.04) 0%,
        rgba(238,233,220,.16) 28%,
        rgba(238,233,220,.82) 57%,
        #eee9dc 78%,
        #eee9dc 100%
      ) !important;
    z-index:1 !important;
    pointer-events:none !important;
  }

  .identity-presence .hero-content{
    position:relative !important;
    z-index:2 !important;
    width:100% !important;
    margin:0 !important;
  }

  .identity-presence .page-hero:before{
    top:76px !important;
    right:20px !important;
    font-size:8px !important;
  }

  .identity-presence .page-hero h1{
    font-size:clamp(3.35rem,15.5vw,6.2rem) !important;
    line-height:.80 !important;
    letter-spacing:-.065em !important;
    margin:24px 0 0 !important;
    max-width:100% !important;
  }

  .identity-presence .hero-copy{
    max-width:370px !important;
    margin-top:24px !important;
    font-size:14px !important;
    line-height:1.55 !important;
  }

  .identity-presence .hero-content .btn{
    width:100% !important;
    justify-content:center !important;
    box-sizing:border-box !important;
    margin-top:22px !important;
  }

  .identity-presence .hero-side{
    position:relative !important;
    z-index:2 !important;
    width:100% !important;
    max-width:none !important;
    margin-top:26px !important;
    padding:17px 0 0 !important;
    border-left:0 !important;
    border-top:1px solid #18231844 !important;
    display:block !important;
  }

  .identity-presence .hero-side .big{
    display:block !important;
    font-size:clamp(3rem,13vw,4.6rem) !important;
    line-height:.8 !important;
    letter-spacing:-.08em !important;
    margin:0 0 16px !important;
  }

  .identity-presence .hero-side p{
    max-width:280px !important;
    margin:0 0 0 auto !important;
    font-size:11px !important;
    line-height:1.5 !important;
  }

  .identity-presence .page-hero .hero-content:after{
    margin-top:24px !important;
    font-size:7px !important;
  }

  /* ---------- SECTIONS ---------- */

  .identity-presence .section,
  .identity-presence .cta{
    padding-left:20px !important;
    padding-right:20px !important;
  }

  .identity-presence .section{
    padding-top:68px !important;
    padding-bottom:68px !important;
  }

  .identity-presence .section-head{
    display:flex !important;
    flex-direction:column !important;
    gap:22px !important;
  }

  .identity-presence .section-head > div{
    width:100% !important;
  }

  .identity-presence .section-head h2{
    font-size:clamp(2.65rem,11vw,4.6rem) !important;
    line-height:.86 !important;
    letter-spacing:-.055em !important;
    max-width:100% !important;
  }

  .identity-presence .section-head > p{
    width:100% !important;
    max-width:100% !important;
    font-size:14px !important;
    line-height:1.55 !important;
  }

  /* ---------- FEATURES ---------- */

  .identity-presence .feature-grid{
    grid-template-columns:1fr !important;
    gap:1px !important;
    margin-top:36px !important;
  }

  .identity-presence .feature{
    min-height:0 !important;
    padding:24px !important;
  }

  .identity-presence .feature h3{
    font-size:clamp(2.1rem,9vw,3.5rem) !important;
    line-height:.86 !important;
    margin:52px 0 12px !important;
  }

  .identity-presence .feature p{
    font-size:13px !important;
    line-height:1.55 !important;
  }

  /* ---------- STOREFRONT WINDOW ---------- */

  .identity-presence .presence-window{
    display:grid !important;
    grid-template-columns:1fr !important;
    min-height:0 !important;
    margin-top:38px !important;
  }

  .identity-presence .presence-window .window-copy{
    padding:30px 22px !important;
    min-height:330px !important;
  }

  .identity-presence .presence-window h3{
    font-size:clamp(3rem,13vw,5rem) !important;
    line-height:.82 !important;
  }

  .identity-presence .presence-window p{
    max-width:310px !important;
    font-size:12px !important;
    line-height:1.55 !important;
  }

  .identity-presence .presence-window .window-art{
    min-height:300px !important;
  }

  /* ---------- PROCESS ---------- */

  .identity-presence .process{
    margin-top:38px !important;
  }

  .identity-presence .process-row{
    display:grid !important;
    grid-template-columns:38px 1fr !important;
    column-gap:12px !important;
    row-gap:8px !important;
    padding:24px 0 !important;
  }

  .identity-presence .process-row b{
    grid-column:1 !important;
    grid-row:1 / span 2 !important;
    font-size:10px !important;
  }

  .identity-presence .process-row h3{
    grid-column:2 !important;
    font-size:22px !important;
    line-height:.95 !important;
  }

  .identity-presence .process-row p{
    grid-column:2 !important;
    font-size:13px !important;
    line-height:1.5 !important;
    margin:0 !important;
  }

  /* ---------- PRICE ---------- */

  .identity-presence .price-band{
    display:block !important;
    padding:34px 20px !important;
  }

  .identity-presence .price-band .price{
    font-size:clamp(3.5rem,16vw,5.5rem) !important;
    line-height:.82 !important;
  }

  .identity-presence .price-band p{
    max-width:360px !important;
    margin-top:20px !important;
    font-size:13px !important;
    line-height:1.5 !important;
  }

  .identity-presence .price-band:after{
    position:static !important;
    display:block !important;
    transform:none !important;
    margin-top:12px !important;
  }

  /* ---------- MODEL CARDS ---------- */

  .identity-presence .grid,
  .identity-presence .metric{
    grid-template-columns:1fr !important;
    gap:10px !important;
  }

  .identity-presence .card,
  .identity-presence .metric-card{
    padding:22px !important;
  }

  /* ---------- FAQ ---------- */

  .identity-presence .faq{
    grid-template-columns:1fr !important;
    gap:0 !important;
